# 복사해서 .env.local 로 사용하세요. 값이 비어 있으면 해당 기능은 데모 모드로 동작합니다.

# ── Supabase (DB · 인증 · Realtime) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 (push_subscriptions 조회 등 RLS 우회) — 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=

# ── Google OAuth / Drive (운영자 Drive 한 곳에 인증 사진 저장) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# 사이드바 "드라이브 폴더" 버튼이 열 주소
NEXT_PUBLIC_DRIVE_FOLDER_URL=

# ── Gemini (질문 창구 AI 초안) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Web Push (pnpm dlx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
