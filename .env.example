# 복사해서 .env.local 로 사용하세요. 값이 비어 있으면 해당 기능은 데모 모드로 동작합니다.

# ── Supabase (DB · 인증 · Realtime) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 (push_subscriptions 조회 등 RLS 우회) — 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=
# Vercel 일일 기록 정리 요청 인증용 서버 전용 난수 (최소 32바이트 권장)
CRON_SECRET=

# ── 개인 Google Drive (각자 연결, 파티원은 앱에서만 사진 조회) ──
# Search Console URL 접두어 속성의 HTML 태그 content 값 (선택, 공개 값)
GOOGLE_SITE_VERIFICATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 난수를 base64로 인코딩한 서버 전용 암호화 키. 분실·변경 시 재연결 필요.
DRIVE_TOKEN_ENCRYPTION_KEY=
# 기존 운영자 Drive에 저장된 사진을 읽을 때만 사용 (신규 업로드 미사용)
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── Groq (질문 창구 AI 대화 · 서버 전용) ──
# 기존 GROQ_KEY 이름도 지원합니다. 둘 다 있으면 GROQ_API_KEY를 우선 사용합니다.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Web Push (pnpm dlx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
